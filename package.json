{
	"name": "@dialecte/scl",
	"version": "0.16.0",
	"description": "Dialecte - SCL (Substation Configuration Language) sdk",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/dialecte/scl.git"
	},
	"source": "src/index.ts",
	"files": [
		"dist",
		"skills",
		"!skills/*/evals"
	],
	"type": "module",
	"exports": {
		"./v2019C1": {
			"types": "./dist/v2019C1/index.d.ts",
			"default": "./dist/v2019C1/index.js"
		},
		"./v2019C1/test": {
			"types": "./dist/v2019C1/test.d.ts",
			"default": "./dist/v2019C1/test.js"
		}
	},
	"scripts": {
		"//====== SCRIPT ======//": "",
		"schema:generate": "node --import=tsx src/script/generate-definition.ts --in src/generated/IEC.generated.json --out src/generated",
		"//====== BUILD ======//": "",
		"build": "run-p type-check \"build-only {@}\" --",
		"build-only": "tsc -p tsconfig.json && vite build",
		"build:watch": "vite build --watch",
		"//====== VITEPRESS ======//": "",
		"doc:generate": "tsx .vitepress/scripts/generate-element-catalog.ts",
		"doc:dev": "npm run doc:generate && vitepress dev",
		"doc:build": "npm run doc:generate && vitepress build",
		"doc:preview": "vitepress preview",
		"//====== TEST ======//": "",
		"test": "npm run test:node && npm run test:browser",
		"test:node": "vitest run --project node",
		"test:browser": "vitest run --project browser --passWithNoTests",
		"test:browser:all": "vitest run --project browser-all",
		"test:hook": "dialecte gate --hook",
		"test:corpus": "vitest --project corpus",
		"corpus:sync": "tsx scripts/sync-corpus.ts",
		"corpus:check-excluded": "tsx scripts/sync-corpus.ts --check-excluded",
		"xsd:sync": "tsx scripts/sync-xsd.ts",
		"//====== CHECK ======//": "",
		"check": "run-p type-check type-check:test type-check:node lint:check format:check",
		"skills:generate": "dialecte skills generate",
		"skills:check": "dialecte skills check",
		"type-check": "tsc -p tsconfig.build.json --noEmit",
		"type-check:test": "tsc -p tsconfig.vitest.json --noEmit",
		"type-check:node": "tsc -p tsconfig.node.json --noEmit",
		"lint:check": "oxlint",
		"lint:fix": "oxlint . --fix -D correctness --ignore-path .gitignore",
		"format:check": "oxfmt --check",
		"format:fix": "oxfmt",
		"format:xml": "dialecte-xmlfmt 'src/**/*.test.ts'",
		"format:xml:check": "dialecte-xmlfmt --check 'src/**/*.test.ts'",
		"//====== TYPE PERF ======//": "",
		"coverage:gen": "dialecte coverage",
		"type-bench": "npm run coverage:gen && dialecte bench",
		"type-bench:check": "npm run coverage:gen && dialecte bench --check",
		"type-narrowing": "npm run coverage:gen && dialecte narrowing",
		"type-audit": "dialecte audit",
		"//====== HOOKS ======//": "",
		"prepare": "husky"
	},
	"dependencies": {
		"@dialecte/core": "0.10.0"
	},
	"devDependencies": {
		"@dialecte/cli": "0.6.0",
		"@stryker-mutator/core": "10.0.0",
		"@stryker-mutator/vitest-runner": "10.0.0",
		"@tsconfig/node24": "^24.0.4",
		"@types/node": "^24.12.4",
		"@typescript/native": "npm:typescript@^7.0.2",
		"@vitest/browser-playwright": "^4.1.10",
		"husky": "^9.1.7",
		"jiti": "^2.4.2",
		"libxml2-wasm": "0.7.2",
		"npm-run-all2": "^8.0.4",
		"oxfmt": "^0.75.0",
		"oxlint": "^1.81.0",
		"oxlint-tsgolint": "^7.0.2001",
		"playwright": "^1.61.1",
		"tsx": "^4.22.4",
		"typescript": "npm:@typescript/typescript6@^6.0.2",
		"vite": "8.0.16",
		"vite-plugin-dts": "^5.0.2",
		"vitepress": "^2.0.0-alpha.17",
		"vitepress-mermaid-renderer": "^1.1.21",
		"vitepress-plugin-llms": "^1.13.1",
		"vitest": "^4.1.10"
	},
	"peerDependencies": {
		"libxml2-wasm": "^0.7.2",
		"vitest": "^4.1.10"
	},
	"peerDependenciesMeta": {
		"libxml2-wasm": {
			"optional": true
		},
		"vitest": {
			"optional": true
		}
	},
	"dialecte": {
		"profile": "contributor",
		"gate": {
			"fast": [
				{
					"name": "check",
					"run": "npm run check"
				},
				{
					"name": "skills",
					"run": "npm run skills:check"
				},
				{
					"name": "tests",
					"run": "npx vitest run --project node --changed",
					"counts": "tests",
					"changedOnly": true
				}
			],
			"full": [
				{
					"name": "check",
					"run": "npm run check"
				},
				{
					"name": "skills",
					"run": "npm run skills:check"
				},
				{
					"name": "build",
					"run": "npm run build"
				},
				{
					"name": "tests",
					"run": "npx vitest run --project node",
					"counts": "tests"
				},
				{
					"name": "browser tests",
					"run": "npx vitest run --project browser",
					"counts": "tests"
				}
			]
		},
		"generatedDocs": [
			".vitepress/data/elements-catalog.json",
			"doc/v2019C1/api/elements.md"
		],
		"referencePatterns": [
			"61850-[0-9]+ ?§",
			"9[0]-30",
			"7-[0-9] ?§"
		],
		"tdd": {
			"production": [
				"src/v2019C1/test"
			]
		},
		"mutation": {
			"scope": [
				"src/v2019C1/extensions/lifecycle/engine/**",
				"src/v2019C1/extensions/lifecycle/layers/**",
				"src/v2019C1/extensions/lifecycle/report/**",
				"src/v2019C1/extensions/lifecycle/apply/**",
				"src/v2019C1/extensions/lifecycle/update/**",
				"src/v2019C1/extensions/lifecycle/extract/**",
				"src/v2019C1/extensions/lifecycle/instantiate/**",
				"src/v2019C1/extensions/lifecycle/instance/**",
				"src/v2019C1/extensions/lifecycle/integration/**",
				"src/v2019C1/extensions/lifecycle/mapping/**",
				"src/v2019C1/extensions/lifecycle/transplant/**",
				"src/v2019C1/extensions/lifecycle/constraints/**",
				"src/v2019C1/extensions/lifecycle/cross-cutting/**",
				"src/v2019C1/extensions/lifecycle/source-root/**",
				"src/v2019C1/extensions/lifecycle/validate/**",
				"src/v2019C1/extensions/identity/**",
				"src/v2019C1/extensions/reference/transaction/apply-uuid-remap.ts",
				"src/v2019C1/extensions/reference/transaction/apply-type-id-remap.ts"
			],
			"exclude": [
				"**/*.constants.ts",
				"**/errors/**",
				"**/test/**",
				"**/*.test.ts"
			],
			"errorFactories": [
				"throwDialecteError",
				"createDialecteError",
				"invariant"
			],
			"fast": {
				"vitestConfig": "scripts/mutants/vitest.mutation.config.ts"
			},
			"full": {
				"command": "npx vitest run --project browser-all --bail=1 --maxWorkers=2"
			}
		}
	}
}
