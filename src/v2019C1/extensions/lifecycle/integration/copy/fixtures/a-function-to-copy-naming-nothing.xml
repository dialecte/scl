<?xml version="1.0" encoding="UTF-8"?>
<!-- S1/VL1/B1: category C1 naming F1, variable V1 applying to F1, node L1 (n1), F1 (f1) holding its behaviour FB (naming
     XCBR1 of SF1), its file reference, PTRC1 (ln1, bound to P1's PPTRC2 by uuid, specified as PTRC1 on no IED, its Op
     mapped on PPTRC3, its Trip input P1's GGIO1 ExtRef, its Block input naming an LNode the document lacks, ln-gone), CSWI1 (ln4, bound to S_IED's
     CSWI1, specified on S_IED's LD0), SF1 holding XCBR1 (ln3, bound to nothing), and its breaker QA1 on L1.
     S1/VL1/B2: F2 holding CSWI1 (ln2). S1/VL1/B3 holds nothing. -->
<SCL xmlns="http://www.iec.ch/61850/2003/SCL" xmlns:dev="http://dialecte.dev/XML/DEV" xmlns:eIEC61850-6-100="http://www.iec.ch/61850/2019/SCL/6-100" release="5" revision="C" version="2007" dev:db-id="project" eIEC61850-6-100:release="1" eIEC61850-6-100:revision="C" eIEC61850-6-100:version="2019">
    <Substation name="S1" dev:db-id="s1">
        <VoltageLevel name="VL1" dev:db-id="vl1">
            <Bay name="B1" dev:db-id="b1">
                <Private type="eIEC61850-6-100" dev:db-id="b1-private">
                    <eIEC61850-6-100:FunctionCategory name="C1" uuid="c1" dev:db-id="c1">
                        <eIEC61850-6-100:FunctionCatRef function="S1/VL1/B1/F1" functionUuid="f1" dev:db-id="cat-ref"/>
                    </eIEC61850-6-100:FunctionCategory>
                    <eIEC61850-6-100:Variable name="V1" value="1" uuid="v1" dev:db-id="v1">
                        <eIEC61850-6-100:VariableApplyTo element="S1/VL1/B1/F1" elementUuid="f1" dev:db-id="var-apply"/>
                    </eIEC61850-6-100:Variable>
                </Private>
                <ConnectivityNode name="L1" pathName="S1/VL1/B1/L1" uuid="n1" dev:db-id="l1"/>
                <Function name="F1" uuid="f1" dev:db-id="f1">
                    <Private type="eIEC61850-6-100" dev:db-id="f1-private">
                        <eIEC61850-6-100:BehaviorDescription name="FB" dev:db-id="fb">
                            <eIEC61850-6-100:OutputVar varName="pos" dataName="SF1/XCBR1.Pos" lnodeUuid="ln3" doName="Pos" dev:db-id="fb-pos"/>
                        </eIEC61850-6-100:BehaviorDescription>
                        <eIEC61850-6-100:FunctionSclRef dev:db-id="f1-file">
                            <eIEC61850-6-100:SclFileReference fileName="feeder.fsd" fileType="FSD" version="1" revision="A" dev:db-id="f1-file-reference"/>
                        </eIEC61850-6-100:FunctionSclRef>
                    </Private>
                    <LNode iedName="P1" ldInst="LD0" prefix="P" lnClass="PTRC" lnInst="2" lnUuid="p1-ptrc-uuid" uuid="ln1" dev:db-id="ln1">
                        <Private type="eIEC61850-6-100" dev:db-id="ln1-private">
                            <eIEC61850-6-100:LNodeSpecNaming sLnClass="PTRC" sLnInst="1" dev:db-id="ln1-naming"/>
                            <eIEC61850-6-100:DOS name="Op" mappedLnUuid="p1-ptrc3-uuid" mappedDoName="Op" dev:db-id="ln1-op"/>
                            <eIEC61850-6-100:LNodeInputs dev:db-id="ln1-inputs">
                                <eIEC61850-6-100:SourceRef input="Trip" extRefUuid="p1-trip-input-uuid" extRefAddr="LD0/GGIO1.Trip" dev:db-id="trip-input"/>
                                <eIEC61850-6-100:SourceRef input="Block" source="S1/VL1/B2/F2/CSWI9.Pos" sourceLNodeUuid="ln-gone" sourceDoName="Pos" dev:db-id="block-input"/>
                            </eIEC61850-6-100:LNodeInputs>
                        </Private>
                    </LNode>
                    <LNode iedName="S_IED" ldInst="LD0" lnClass="CSWI" lnInst="1" lnUuid="s-cswi-uuid" uuid="ln4" dev:db-id="ln4">
                        <Private type="eIEC61850-6-100" dev:db-id="ln4-private">
                            <eIEC61850-6-100:LNodeSpecNaming sIedName="S_IED" sLdInst="LD0" sLnClass="CSWI" sLnInst="1" dev:db-id="ln4-naming"/>
                        </Private>
                    </LNode>
                    <SubFunction name="SF1" uuid="sf1" dev:db-id="sf1">
                        <LNode iedName="None" lnClass="XCBR" lnInst="1" uuid="ln3" dev:db-id="ln3"/>
                    </SubFunction>
                    <ConductingEquipment name="QA1" type="CBR" dev:db-id="qa1">
                        <Terminal connectivityNode="S1/VL1/B1/L1" substationName="S1" voltageLevelName="VL1" bayName="B1" cNodeName="L1" cNodeUuid="n1" dev:db-id="qa1-terminal"/>
                    </ConductingEquipment>
                </Function>
            </Bay>
            <Bay name="B2" dev:db-id="b2">
                <Function name="F2" uuid="f2" dev:db-id="f2">
                    <LNode iedName="None" lnClass="CSWI" lnInst="1" uuid="ln2" dev:db-id="ln2"/>
                </Function>
            </Bay>
            <Bay name="B3" dev:db-id="b3"/>
        </VoltageLevel>
    </Substation>
    <IED name="S_IED" dev:db-id="s-ied">
        <AccessPoint name="AP1" dev:db-id="s-ap1">
            <Server dev:db-id="s-server">
                <Authentication dev:db-id="s-authentication"/>
                <LDevice inst="LD0" dev:db-id="s-ld0">
                    <LN0 lnClass="LLN0" inst="" lnType="LLN0_T" dev:db-id="s-lln0"/>
                    <LN lnClass="CSWI" inst="1" lnType="CSWI_T" uuid="s-cswi-uuid" dev:db-id="s-cswi"/>
                </LDevice>
            </Server>
        </AccessPoint>
    </IED>
    <IED name="P1" dev:db-id="p1">
        <IEDSourceFiles dev:db-id="p1-files">
            <SclFileReference fileType="ICD" dev:db-id="p1-file"/>
        </IEDSourceFiles>
        <AccessPoint name="AP1" dev:db-id="p1-ap1">
            <Server dev:db-id="p1-server">
                <Authentication dev:db-id="p1-authentication"/>
                <LDevice inst="LD0" dev:db-id="p1-ld0">
                    <LN0 lnClass="LLN0" inst="" lnType="LLN0_T" dev:db-id="p1-lln0"/>
                    <LN prefix="P" lnClass="PTRC" inst="2" lnType="PTRC_T" uuid="p1-ptrc-uuid" dev:db-id="p1-ptrc"/>
                    <LN prefix="P" lnClass="PTRC" inst="3" lnType="PTRC_T" uuid="p1-ptrc3-uuid" dev:db-id="p1-ptrc3"/>
                    <LN lnClass="GGIO" inst="1" lnType="GGIO_T" uuid="p1-ggio-uuid" dev:db-id="p1-ggio">
                        <Inputs dev:db-id="p1-ggio-inputs">
                            <ExtRef intAddr="Trip" uuid="p1-trip-input-uuid" dev:db-id="p1-trip-input"/>
                        </Inputs>
                    </LN>
                </LDevice>
            </Server>
        </AccessPoint>
    </IED>
    <DataTypeTemplates dev:db-id="templates">
        <LNodeType id="LLN0_T" lnClass="LLN0" dev:db-id="lln0-type">
            <DO name="Beh" type="ENS_T" dev:db-id="lln0-beh"/>
        </LNodeType>
        <LNodeType id="PTRC_T" lnClass="PTRC" dev:db-id="ptrc-type">
            <DO name="Op" type="ACT_T" dev:db-id="ptrc-op"/>
        </LNodeType>
        <LNodeType id="GGIO_T" lnClass="GGIO" dev:db-id="ggio-type">
            <DO name="Beh" type="ENS_T" dev:db-id="ggio-beh"/>
        </LNodeType>
        <LNodeType id="CSWI_T" lnClass="CSWI" dev:db-id="cswi-type">
            <DO name="Pos" type="DPC_T" dev:db-id="cswi-pos"/>
        </LNodeType>
        <DOType id="ENS_T" cdc="ENS" dev:db-id="ens-type">
            <DA name="stVal" bType="INT32" fc="ST" dev:db-id="ens-stval"/>
        </DOType>
        <DOType id="ACT_T" cdc="ACT" dev:db-id="act-type">
            <DA name="general" bType="BOOLEAN" fc="ST" dev:db-id="act-general"/>
        </DOType>
        <DOType id="DPC_T" cdc="DPC" dev:db-id="dpc-type">
            <DA name="stVal" bType="Dbpos" fc="ST" dev:db-id="dpc-stval"/>
        </DOType>
    </DataTypeTemplates>
</SCL>
