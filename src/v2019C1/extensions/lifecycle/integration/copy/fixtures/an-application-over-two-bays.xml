                            <eIEC61850-6-100:FunctionRoleContent dev:db-id="a3-root-content">
                                <eIEC61850-6-100:FunctionRef function="S1/VL1/B1/F1" functionUuid="f1" dev:db-id="a3-f1"/>
                                <eIEC61850-6-100:FunctionRef function="S1/VL1/B3/F1" functionUuid="f1b" dev:db-id="a3-f1b"/>
