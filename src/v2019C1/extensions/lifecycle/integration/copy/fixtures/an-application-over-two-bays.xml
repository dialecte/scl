                            <eIEC61850-6-100:FunctionRoleContent dev:db-id="a4-root-content">
                                <eIEC61850-6-100:FunctionRef function="S1/VL1/B1/F1" functionUuid="f1" dev:db-id="a4-f1"/>
                                <eIEC61850-6-100:FunctionRef function="S1/VL1/H2" functionUuid="h2" dev:db-id="a4-h2"/>
                            </eIEC61850-6-100:FunctionRoleContent>
                        </eIEC61850-6-100:FunctionRole>
                    </eIEC61850-6-100:Application>
                    <eIEC61850-6-100:Application name="A5" type="DCS" uuid="a5" dev:db-id="a5">
