                                <eIEC61850-6-100:FunctionRef function="S1/VL3/B5/F5" functionUuid="f5" dev:db-id="a5-f5"/>
                            </eIEC61850-6-100:FunctionRoleContent>
                        </eIEC61850-6-100:FunctionRole>
                    </eIEC61850-6-100:Application>
                </Private>
                <Function name="F1" uuid="f1" dev:db-id="f1"/>
            </Bay>
            <Bay name="B3" dev:db-id="b3">
