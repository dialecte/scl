<!-- S1/VL1/B1: A6 composing F1 (in B1) and F4 (in B3); F1. S1/VL1/B3: the bay's behaviour BB (its Op output naming F4's
     LNode ln4, its Block input the LNode ln9 of S1/VL2/B1); F4 holding ln4. S1/VL2: B1 holding the LNode ln9; B9 empty. -->
<SCL xmlns="http://www.iec.ch/61850/2003/SCL" xmlns:dev="http://dialecte.dev/XML/DEV" xmlns:eIEC61850-6-100="http://www.iec.ch/61850/2019/SCL/6-100" release="5" revision="C" version="2007" dev:db-id="project" eIEC61850-6-100:release="1" eIEC61850-6-100:revision="C" eIEC61850-6-100:version="2019">
    <Substation name="S1" dev:db-id="s1">
        <VoltageLevel name="VL1" dev:db-id="vl1">
            <Bay name="B1" dev:db-id="b1">
                <Private type="eIEC61850-6-100" dev:db-id="b1-private">
                    <eIEC61850-6-100:Application name="A6" type="DCS" uuid="a6" dev:db-id="a6">
                        <eIEC61850-6-100:FunctionRole name="ROOT" dev:db-id="a6-root">
                            <eIEC61850-6-100:FunctionRoleContent dev:db-id="a6-root-content">
                                <eIEC61850-6-100:FunctionRef function="S1/VL1/B1/F1" functionUuid="f1" dev:db-id="a6-f1"/>
                                <eIEC61850-6-100:FunctionRef function="S1/VL1/B3/F4" functionUuid="f4" dev:db-id="a6-f4"/>
                            </eIEC61850-6-100:FunctionRoleContent>
                        </eIEC61850-6-100:FunctionRole>
                    </eIEC61850-6-100:Application>
                </Private>
                <Function name="F1" uuid="f1" dev:db-id="f1"/>
            </Bay>
            <Bay name="B3" dev:db-id="b3">
                <Private type="eIEC61850-6-100" dev:db-id="b3-private">
                    <eIEC61850-6-100:BehaviorDescription name="BB" dev:db-id="bb">
                        <eIEC61850-6-100:InputVar varName="block" dataName="CSWI9.Pos" lnodeUuid="ln9" doName="Pos" dev:db-id="bb-block"/>
                        <eIEC61850-6-100:OutputVar varName="op" dataName="F4/PTRC4.Op" lnodeUuid="ln4" doName="Op" dev:db-id="bb-op"/>
                    </eIEC61850-6-100:BehaviorDescription>
                </Private>
                <Function name="F4" uuid="f4" dev:db-id="f4">
                    <LNode iedName="None" lnClass="PTRC" lnInst="4" uuid="ln4" dev:db-id="ln4"/>
                </Function>
            </Bay>
        </VoltageLevel>
        <VoltageLevel name="VL2" dev:db-id="vl2">
            <Bay name="B1" dev:db-id="vl2-b1">
                <LNode iedName="None" lnClass="CSWI" lnInst="9" uuid="ln9" dev:db-id="ln9"/>
            </Bay>
            <Bay name="B9" dev:db-id="b9"/>
        </VoltageLevel>
    </Substation>
</SCL>
