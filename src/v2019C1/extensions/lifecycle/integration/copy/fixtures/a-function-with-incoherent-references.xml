<?xml version="1.0" encoding="UTF-8"?>
<!-- S1/VL1/B1: the bay's behaviour BB (its Block input naming F3's CSWI1, its Op output F1's PTRC1); F1 holding its behaviour FB
     with two references written incoherently before the checks existed (In naming PTRC1 without its data, Both holding the
     data and the control groups together) and PTRC1 with its Trip output; F3 holding CSWI1. B2 holds nothing. -->
<SCL xmlns="http://www.iec.ch/61850/2003/SCL" xmlns:dev="http://dialecte.dev/XML/DEV" xmlns:eIEC61850-6-100="http://www.iec.ch/61850/2019/SCL/6-100" release="5" revision="C" version="2007" dev:db-id="project" eIEC61850-6-100:release="1" eIEC61850-6-100:revision="C" eIEC61850-6-100:version="2019">
    <Substation name="S1" dev:db-id="s1">
        <VoltageLevel name="VL1" dev:db-id="vl1">
            <Bay name="B1" dev:db-id="b1">
                <Private type="eIEC61850-6-100" dev:db-id="b1-private">
                    <eIEC61850-6-100:BehaviorDescription name="BB" dev:db-id="bb">
                        <eIEC61850-6-100:InputVar varName="block" dataName="F3/CSWI1.Pos" lnodeUuid="ln5" doName="Pos" dev:db-id="bb-block"/>
                        <eIEC61850-6-100:OutputVar varName="op" dataName="F1/PTRC1.Op" lnodeUuid="ln1" doName="Op" dev:db-id="bb-op"/>
                    </eIEC61850-6-100:BehaviorDescription>
                </Private>
                <Function name="F1" uuid="f1" dev:db-id="f1">
                    <Private type="eIEC61850-6-100" dev:db-id="f1-private">
                        <eIEC61850-6-100:BehaviorDescription name="FB" dev:db-id="fb">
                            <eIEC61850-6-100:InputVar varName="in" dataName="PTRC1" lnodeUuid="ln1" dev:db-id="fb-in"/>
                            <eIEC61850-6-100:OutputVar varName="both" dataName="PTRC1.Op" lnodeUuid="ln1" doName="Op" outputName="PTRC1.Trip" outputUuid="trip-out" dev:db-id="fb-both"/>
                        </eIEC61850-6-100:BehaviorDescription>
                    </Private>
                    <LNode iedName="None" lnClass="PTRC" lnInst="1" uuid="ln1" dev:db-id="ln1">
                        <Private type="eIEC61850-6-100" dev:db-id="ln1-private">
                            <eIEC61850-6-100:LNodeOutputs dev:db-id="ln1-outputs">
                                <eIEC61850-6-100:ControlRef output="Trip" uuid="trip-out" dev:db-id="trip-out"/>
                            </eIEC61850-6-100:LNodeOutputs>
                        </Private>
                    </LNode>
                </Function>
                <Function name="F3" uuid="f3" dev:db-id="f3">
                    <LNode iedName="None" lnClass="CSWI" lnInst="1" uuid="ln5" dev:db-id="ln5"/>
                </Function>
            </Bay>
            <Bay name="B2" dev:db-id="b2"/>
        </VoltageLevel>
    </Substation>
</SCL>
