<?xml version="1.0" encoding="UTF-8"?>
<!-- S1/VL1/B1: A7 composing F7, its ROOT role also naming the EqFunction EQ8 of B2's breaker QB8 (with a SignalRole left empty on purpose: a
     reference inside it would bring a pair no family groups);
     A8 composing F7 and F9. F7: LNode lnf7 whose SourceRef "Block" names F8's XCBR8 (ln8) and whose ControlRef "Open"
     controls it. F9: LNode lnf9 whose SourceRef "Block" names ln8 and whose SourceRef "Ready" names F7's lnf7.
     S1/VL1/B2: F8 holding XCBR8 (ln8); breaker QB8 holding EQ8. S1/VL1/B3 holds nothing. -->
<SCL xmlns="http://www.iec.ch/61850/2003/SCL" xmlns:dev="http://dialecte.dev/XML/DEV" xmlns:eIEC61850-6-100="http://www.iec.ch/61850/2019/SCL/6-100" release="5" revision="C" version="2007" dev:db-id="project" eIEC61850-6-100:release="1" eIEC61850-6-100:revision="C" eIEC61850-6-100:version="2019">
    <Substation name="S1" dev:db-id="s1">
        <VoltageLevel name="VL1" dev:db-id="vl1">
            <Bay name="B1" dev:db-id="b1">
                <Private type="eIEC61850-6-100" dev:db-id="b1-private">
                    <eIEC61850-6-100:Application name="A7" type="DCS" uuid="a7" dev:db-id="a7">
                        <eIEC61850-6-100:FunctionRole name="ROOT" dev:db-id="a7-root">
                            <eIEC61850-6-100:FunctionRoleContent dev:db-id="a7-root-content">
                                <eIEC61850-6-100:FunctionRef function="S1/VL1/B1/F7" functionUuid="f7" dev:db-id="a7-f7"/>
                                <eIEC61850-6-100:FunctionRef function="S1/VL1/B2/QB8/EQ8" functionUuid="eq8" dev:db-id="a7-eq8">
                                    <eIEC61850-6-100:SignalRole name="Trip" uuid="a7-eq8-trip" dev:db-id="a7-eq8-trip"/>
                                </eIEC61850-6-100:FunctionRef>
                            </eIEC61850-6-100:FunctionRoleContent>
                        </eIEC61850-6-100:FunctionRole>
                    </eIEC61850-6-100:Application>
                    <eIEC61850-6-100:Application name="A8" type="DCS" uuid="a8" dev:db-id="a8">
                        <eIEC61850-6-100:FunctionRole name="ROOT" dev:db-id="a8-root">
                            <eIEC61850-6-100:FunctionRoleContent dev:db-id="a8-root-content">
                                <eIEC61850-6-100:FunctionRef function="S1/VL1/B1/F7" functionUuid="f7" dev:db-id="a8-f7"/>
                                <eIEC61850-6-100:FunctionRef function="S1/VL1/B1/F9" functionUuid="f9" dev:db-id="a8-f9"/>
                            </eIEC61850-6-100:FunctionRoleContent>
                        </eIEC61850-6-100:FunctionRole>
                    </eIEC61850-6-100:Application>
                </Private>
                <Function name="F7" uuid="f7" dev:db-id="f7">
                    <LNode iedName="None" lnClass="CSWI" lnInst="7" uuid="lnf7" dev:db-id="lnf7">
                        <Private type="eIEC61850-6-100" dev:db-id="lnf7-private">
                            <eIEC61850-6-100:LNodeInputs dev:db-id="lnf7-inputs">
                                <eIEC61850-6-100:SourceRef input="Block" source="S1/VL1/B2/F8/XCBR8.Pos" sourceLNodeUuid="ln8" sourceDoName="Pos" dev:db-id="f7-block"/>
                            </eIEC61850-6-100:LNodeInputs>
                            <eIEC61850-6-100:LNodeOutputs dev:db-id="lnf7-outputs">
                                <eIEC61850-6-100:ControlRef output="Open" controlled="S1/VL1/B2/F8/XCBR8.Pos" controlledLNodeUuid="ln8" controlledDoName="Pos" dev:db-id="f7-open"/>
                            </eIEC61850-6-100:LNodeOutputs>
                        </Private>
                    </LNode>
                </Function>
                <Function name="F9" uuid="f9" dev:db-id="f9">
                    <LNode iedName="None" lnClass="CSWI" lnInst="9" uuid="lnf9" dev:db-id="lnf9">
                        <Private type="eIEC61850-6-100" dev:db-id="lnf9-private">
                            <eIEC61850-6-100:LNodeInputs dev:db-id="lnf9-inputs">
                                <eIEC61850-6-100:SourceRef input="Block" source="S1/VL1/B2/F8/XCBR8.Pos" sourceLNodeUuid="ln8" sourceDoName="Pos" dev:db-id="f9-block"/>
                                <eIEC61850-6-100:SourceRef input="Ready" source="S1/VL1/B1/F7/CSWI7.Pos" sourceLNodeUuid="lnf7" sourceDoName="Pos" dev:db-id="f9-ready"/>
                            </eIEC61850-6-100:LNodeInputs>
                        </Private>
                    </LNode>
                </Function>
            </Bay>
            <Bay name="B2" dev:db-id="b2">
                <ConductingEquipment name="QB8" type="CBR" dev:db-id="qb8">
                    <EqFunction name="EQ8" uuid="eq8" dev:db-id="eq8"/>
                </ConductingEquipment>
                <Function name="F8" uuid="f8" dev:db-id="f8">
                    <LNode iedName="None" lnClass="XCBR" lnInst="8" uuid="ln8" dev:db-id="ln8"/>
                </Function>
            </Bay>
            <Bay name="B3" dev:db-id="b3"/>
        </VoltageLevel>
    </Substation>
</SCL>
