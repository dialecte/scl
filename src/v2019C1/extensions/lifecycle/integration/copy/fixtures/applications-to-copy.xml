<?xml version="1.0" encoding="UTF-8"?>
<!-- S1/VL1/B1: the role R allocating F1; A1 composing F1 (ROOT, which also names the variable V2) and F2 (SUB), allocated
     to R; V2 applying to F1; A2 composing F3 (in B1) and F4 (in B3); F1 (CSWI1), F2 (PTRC1), F3. B2 holds nothing.
     S1/VL1 itself: A3 composing H1, H1 sitting under VL1. -->
<SCL xmlns="http://www.iec.ch/61850/2003/SCL" xmlns:dev="http://dialecte.dev/XML/DEV" xmlns:eIEC61850-6-100="http://www.iec.ch/61850/2019/SCL/6-100" release="5" revision="C" version="2007" dev:db-id="project" eIEC61850-6-100:release="1" eIEC61850-6-100:revision="C" eIEC61850-6-100:version="2019">
    <Substation name="S1" dev:db-id="s1">
        <VoltageLevel name="VL1" dev:db-id="vl1">
            <Private type="eIEC61850-6-100" dev:db-id="vl1-private">
                <eIEC61850-6-100:Application name="A3" type="DCS" uuid="a3" dev:db-id="a3">
                    <eIEC61850-6-100:FunctionRole name="ROOT" dev:db-id="a3-root">
                        <eIEC61850-6-100:FunctionRoleContent dev:db-id="a3-root-content">
                            <eIEC61850-6-100:FunctionRef function="S1/VL1/H1" functionUuid="h1" dev:db-id="a3-h1"/>
                        </eIEC61850-6-100:FunctionRoleContent>
                    </eIEC61850-6-100:FunctionRole>
                </eIEC61850-6-100:Application>
            </Private>
            <Bay name="B1" dev:db-id="b1">
                <Private type="eIEC61850-6-100" dev:db-id="b1-private">
                    <eIEC61850-6-100:Variable name="V2" value="1" uuid="v2" dev:db-id="v2">
                        <eIEC61850-6-100:VariableApplyTo element="S1/VL1/B1/F1" elementUuid="f1" dev:db-id="v2-apply"/>
                    </eIEC61850-6-100:Variable>
                    <eIEC61850-6-100:AllocationRole name="R" uuid="r" dev:db-id="r">
                        <eIEC61850-6-100:FunctionRef function="S1/VL1/B1/F1" functionUuid="f1" dev:db-id="r-f1"/>
                    </eIEC61850-6-100:AllocationRole>
                    <eIEC61850-6-100:Application name="A1" type="DCS" uuid="a1" dev:db-id="a1">
                        <eIEC61850-6-100:FunctionRole name="ROOT" dev:db-id="a1-root">
                            <eIEC61850-6-100:FunctionRoleContent dev:db-id="a1-root-content">
                                <eIEC61850-6-100:FunctionRef function="S1/VL1/B1/F1" functionUuid="f1" dev:db-id="a1-f1"/>
                                <eIEC61850-6-100:VariableRef variable="S1/VL1/B1/V2" variableUuid="v2" dev:db-id="a1-v2"/>
                            </eIEC61850-6-100:FunctionRoleContent>
                        </eIEC61850-6-100:FunctionRole>
                        <eIEC61850-6-100:FunctionRole name="SUB" dev:db-id="a1-sub">
                            <eIEC61850-6-100:FunctionRoleContent dev:db-id="a1-sub-content">
                                <eIEC61850-6-100:FunctionRef function="S1/VL1/B1/F2" functionUuid="f2" dev:db-id="a1-f2"/>
                            </eIEC61850-6-100:FunctionRoleContent>
                        </eIEC61850-6-100:FunctionRole>
                        <eIEC61850-6-100:AllocationRoleRef allocationRole="S1/VL1/B1/R" allocationRoleUuid="r" dev:db-id="a1-r"/>
                    </eIEC61850-6-100:Application>
                    <eIEC61850-6-100:Application name="A2" type="DCS" uuid="a2" dev:db-id="a2">
                        <eIEC61850-6-100:FunctionRole name="ROOT" dev:db-id="a2-root">
                            <eIEC61850-6-100:FunctionRoleContent dev:db-id="a2-root-content">
                                <eIEC61850-6-100:FunctionRef function="S1/VL1/B1/F3" functionUuid="f3" dev:db-id="a2-f3"/>
                                <eIEC61850-6-100:FunctionRef function="S1/VL1/B3/F4" functionUuid="f4" dev:db-id="a2-f4"/>
                            </eIEC61850-6-100:FunctionRoleContent>
                        </eIEC61850-6-100:FunctionRole>
                    </eIEC61850-6-100:Application>
                </Private>
                <Function name="F1" uuid="f1" dev:db-id="f1">
                    <LNode iedName="None" lnClass="CSWI" lnInst="1" uuid="ln1" dev:db-id="ln1"/>
                </Function>
                <Function name="F2" uuid="f2" dev:db-id="f2">
                    <LNode iedName="None" lnClass="PTRC" lnInst="1" uuid="ln2" dev:db-id="ln2"/>
                </Function>
                <Function name="F3" uuid="f3" dev:db-id="f3"/>
            </Bay>
            <Bay name="B2" dev:db-id="b2"/>
            <Bay name="B3" dev:db-id="b3">
                <Function name="F4" uuid="f4" dev:db-id="f4"/>
            </Bay>
            <Function name="H1" uuid="h1" dev:db-id="h1"/>
        </VoltageLevel>
    </Substation>
</SCL>
