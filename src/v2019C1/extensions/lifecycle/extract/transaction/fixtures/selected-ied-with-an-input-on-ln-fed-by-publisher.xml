	<!-- IED Selected whose PTOC holds one input bound to the PTOC of IED Publisher -->
	<Header id="ProjectSource" fileType="SCD" uuid="10000000-0000-4000-8000-000000000001" version="2" revision="B"/>
	<IED name="Selected" uuid="20000000-0000-4000-8000-000000000001" dev:db-id="selected-ied">
		<Private type="vendor.outside">
			<vendor:Settings mode="retained">outside payload</vendor:Settings>
		</Private>
		<AccessPoint name="AP1" uuid="30000000-0000-4000-8000-000000000001">
			<Server>
				<Authentication/>
				<LDevice inst="LD1">
					<LN0 lnClass="LLN0" inst="" lnType="LLN0_Type" uuid="50000000-0000-4000-8000-000000000001" dev:db-id="selected-ln0">
						<!-- no Inputs -->
					</LN0>
					<LN lnClass="PTOC" inst="1" lnType="PTOC_Type" uuid="50000000-0000-4000-8000-000000000002" dev:db-id="selected-ln">
						<DOI name="Status">
							<DAI name="stVal">
