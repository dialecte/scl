			<DO name="Status" type="Status_Type"/>
		</LNodeType>
		<LNodeType id="PTOC_Type" lnClass="PTOC">
			<DO name="Status" type="Status_Type"/>
		</LNodeType>
		<DOType id="Status_Type" cdc="SPS">
			<DA name="stVal" bType="BOOLEAN" fc="ST"/>
		</DOType>
	</DataTypeTemplates>
