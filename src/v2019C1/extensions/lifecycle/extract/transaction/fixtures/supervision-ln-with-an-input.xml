<SCL xmlns="http://www.iec.ch/61850/2003/SCL" xmlns:eIEC61850-6-100="http://www.iec.ch/61850/2019/SCL/6-100" xmlns:dev="http://dialecte.dev/XML/DEV" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" dev:db-id="scl">
	<!-- A holds a GOOSE supervision LN with an input lacking its description and expected data; no supervision capability -->
	<IED name="A" uuid="20000000-0000-4000-8000-00000000000a" dev:db-id="ied-a">
		<AccessPoint name="AP1">
			<Server>
				<Authentication/>
				<LDevice inst="LD1">
					<LN0 lnClass="LLN0" inst="" lnType="LN_T"/>
					<LN lnClass="LGOS" inst="1" prefix="" lnType="LN_T" dev:db-id="supervision-ln">
						<Inputs>
							<ExtRef intAddr="GoCBRef" dev:db-id="supervision-input"/>
						</Inputs>
					</LN>
				</LDevice>
			</Server>
		</AccessPoint>
	</IED>
	<DataTypeTemplates>
		<LNodeType id="LN_T" lnClass="PTRC">
			<DO name="Op" type="ACT_T"/>
		</LNodeType>
		<DOType id="ACT_T" cdc="ACT">
			<DA name="general" bType="BOOLEAN" fc="ST"/>
		</DOType>
	</DataTypeTemplates>
</SCL>
