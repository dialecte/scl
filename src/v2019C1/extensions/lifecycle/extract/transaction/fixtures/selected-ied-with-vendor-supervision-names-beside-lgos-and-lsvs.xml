<SCL xmlns="http://www.iec.ch/61850/2003/SCL" xmlns:eIEC61850-6-100="http://www.iec.ch/61850/2019/SCL/6-100" xmlns:dev="http://dialecte.dev/XML/DEV" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:vendor="urn:ied-vendor-content:test" dev:db-id="source-root">
	<!-- IED Selected whose vendor Private holds vendor LN named LGOS and LSVS, beside a real LGOS and a real LSVS -->
	<Header id="ProjectSource" fileType="SCD" uuid="10000000-0000-4000-8000-000000000001" version="2" revision="B"/>
	<IED name="Selected" uuid="20000000-0000-4000-8000-000000000001" dev:db-id="selected-ied">
		<Private type="vendor.payload">
			<vendor:LN lnClass="LGOS" inst="vendorG" dev:db-id="vendor-lgos">vendor GOOSE data</vendor:LN>
			<vendor:LN lnClass="LSVS" inst="vendorS" dev:db-id="vendor-lsvs">vendor sampled data</vendor:LN>
			<vendor:Keep mode="retained">unrelated vendor payload</vendor:Keep>
		</Private>
		<AccessPoint name="AP1" uuid="30000000-0000-4000-8000-000000000001">
			<Server>
				<Authentication/>
				<LDevice inst="LD1">
					<LN0 lnClass="LLN0" inst="" lnType="LLN0_Type">
						<ReportControl name="ReportEvents" confRev="1">
							<OptFields/>
							<RptEnabled max="2">
								<!-- no ClientLN -->
							</RptEnabled>
						</ReportControl>
						<GSEControl name="GooseEvents" appID="Events" confRev="1">
							<!-- no IEDName -->
						</GSEControl>
					</LN0>
					<LN lnClass="PTOC" inst="1" lnType="PTOC_Type" uuid="50000000-0000-4000-8000-000000000001">
						<DOI name="Status">
							<DAI name="stVal">
								<Val>true</Val>
							</DAI>
						</DOI>
						<Inputs dev:db-id="real-inputs">
							<ExtRef iedName="Selected" ldInst="LD1" prefix="" lnClass="PTOC" lnInst="1" lnUuid="50000000-0000-4000-8000-000000000001" doName="Status" daName="stVal" serviceType="Poll" intAddr="status"/>
						</Inputs>
					</LN>
					<LN lnClass="LGOS" inst="1" lnType="LGOS_Type" dev:db-id="real-lgos"/>
					<LN lnClass="LSVS" inst="1" lnType="LSVS_Type" dev:db-id="real-lsvs"/>
				</LDevice>
				<!-- no Association -->
			</Server>
		</AccessPoint>
		<!-- no KDC -->
	</IED>
	<IED name="Foreign" uuid="20000000-0000-4000-8000-000000000002">
		<AccessPoint name="AP2" uuid="30000000-0000-4000-8000-000000000002">
			<Server>
				<Authentication/>
				<LDevice inst="LD2">
					<LN0 lnClass="LLN0" inst="" lnType="LLN0_Type"/>
					<LN lnClass="PTOC" inst="2" lnType="PTOC_Type" uuid="50000000-0000-4000-8000-000000000002"/>
				</LDevice>
			</Server>
		</AccessPoint>
	</IED>
	<DataTypeTemplates>
		<LNodeType id="LLN0_Type" lnClass="LLN0">
			<DO name="Status" type="Status_Type"/>
		</LNodeType>
		<LNodeType id="PTOC_Type" lnClass="PTOC">
			<DO name="Status" type="Status_Type"/>
		</LNodeType>
		<LNodeType id="LGOS_Type" lnClass="LGOS">
			<DO name="Status" type="Status_Type"/>
		</LNodeType>
		<LNodeType id="LSVS_Type" lnClass="LSVS">
			<DO name="Status" type="Status_Type"/>
		</LNodeType>
		<DOType id="Status_Type" cdc="SPS">
			<DA name="stVal" bType="BOOLEAN" fc="ST"/>
		</DOType>
	</DataTypeTemplates>
</SCL>
