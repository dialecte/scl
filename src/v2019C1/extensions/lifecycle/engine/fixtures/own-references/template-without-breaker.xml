<?xml version="1.0" encoding="UTF-8"?>
<!-- The breaker IED template without XCBR1 (and its entry in DS): device LD1 holds the data set DS (stVal of XCBR1) sent by the GOOSE GC, an input offered for
     later binding, and XCBR1, whose position carries a structured origin (origin.orCat); device LD2 holds XCBR2 -->
<SCL xmlns="http://www.iec.ch/61850/2003/SCL" xmlns:dev="http://dialecte.dev/XML/DEV" release="5" revision="C" version="2007" dev:db-id="template">
    <IED name="TPL" uuid="ied-src" dev:db-id="ied-s">
        <AccessPoint name="AP1" uuid="ap-src" dev:db-id="ap-s">
            <Server dev:db-id="srv-s">
                <Authentication dev:db-id="auth-s"/>
                <LDevice inst="LD1" uuid="ld-src" dev:db-id="ld-s">
                    <LN0 lnClass="LLN0" inst="" lnType="LLN0_T" uuid="ln0-src" dev:db-id="ln0-s">
                        <DataSet name="DS" uuid="ds-src" dev:db-id="ds-s">
                        </DataSet>
                        <Inputs dev:db-id="in-s">
                            <ExtRef intAddr="spare" uuid="spare-src" dev:db-id="spare-s"/>
                        </Inputs>
                        <GSEControl name="GC" appID="GC" datSet="DS" confRev="1" uuid="gc-src" dev:db-id="gc-s"/>
                    </LN0>
                </LDevice>
                <LDevice inst="LD2" uuid="ld2-src" dev:db-id="ld2-s">
                    <LN0 lnClass="LLN0" inst="" lnType="LLN0_T" uuid="ln02-src" dev:db-id="ln02-s"/>
                    <LN lnClass="XCBR" inst="2" lnType="XCBR_T" uuid="xcbr2-src" dev:db-id="xcbr2-s"/>
                </LDevice>
            </Server>
        </AccessPoint>
    </IED>
    <DataTypeTemplates dev:db-id="dtt-s">
        <LNodeType id="LLN0_T" lnClass="LLN0" dev:db-id="lnt0-s"/>
        <LNodeType id="XCBR_T" lnClass="XCBR" dev:db-id="lnt1-s"><DO name="Pos" type="DPC_T" dev:db-id="do-pos-s"/></LNodeType>
        <DOType id="DPC_T" cdc="DPC" dev:db-id="dot-s">
            <DA name="origin" fc="ST" bType="Struct" type="Originator_T" dev:db-id="da-origin-s"/>
            <DA name="stVal" fc="ST" bType="Dbpos" dev:db-id="da-st-s"/>
            <DA name="q" fc="ST" bType="Quality" dev:db-id="da-q-s"/>
        </DOType>
        <DAType id="Originator_T" dev:db-id="dat-s">
            <BDA name="orCat" bType="Enum" type="orCategory" dev:db-id="bda-cat-s"/>
            <BDA name="orIdent" bType="Octet64" dev:db-id="bda-ident-s"/>
        </DAType>
        <EnumType id="orCategory" dev:db-id="enum-s">
            <EnumVal ord="0" dev:db-id="ev0-s">not-supported</EnumVal>
            <EnumVal ord="1" dev:db-id="ev1-s">bay-control</EnumVal>
        </EnumType>
    </DataTypeTemplates>
</SCL>
