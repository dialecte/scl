<?xml version="1.0" encoding="UTF-8"?>
<!-- The IED A holds AP1 (CTRL sending PositionGoose) and AP2 (SUP), both connected on N1, PositionGoose's address
     under AP1's connection. -->
<SCL xmlns="http://www.iec.ch/61850/2003/SCL" xmlns:dev="http://dialecte.dev/XML/DEV" release="5" revision="C" version="2007" dev:db-id="project">
    <Communication dev:db-id="communication">
        <SubNetwork name="N1" dev:db-id="n1">
            <ConnectedAP iedName="A" apName="AP1" apUuid="a-ap1-uuid" dev:db-id="cap1">
                <GSE ldInst="CTRL" cbName="PositionGoose" cbUuid="position-goose-uuid" dev:db-id="gse"/>
            </ConnectedAP>
            <ConnectedAP iedName="A" apName="AP2" apUuid="a-ap2-uuid" dev:db-id="cap2"/>
        </SubNetwork>
    </Communication>
    <IED name="A" uuid="ied-a-uuid" dev:db-id="ied-a">
        <AccessPoint name="AP1" uuid="a-ap1-uuid" dev:db-id="a-ap1">
            <Server dev:db-id="a-server1">
                <Authentication dev:db-id="a-authentication1"/>
                <LDevice inst="CTRL" uuid="ctrl-uuid" dev:db-id="ctrl">
                    <LN0 lnClass="LLN0" inst="" lnType="LLN0_T" uuid="ctrl-lln0-uuid" dev:db-id="ctrl-lln0">
                        <GSEControl name="PositionGoose" appID="POS" confRev="1" uuid="position-goose-uuid" dev:db-id="position-goose"/>
                    </LN0>
                </LDevice>
            </Server>
        </AccessPoint>
        <AccessPoint name="AP2" uuid="a-ap2-uuid" dev:db-id="a-ap2">
            <Server dev:db-id="a-server2">
                <Authentication dev:db-id="a-authentication2"/>
                <LDevice inst="SUP" uuid="sup-uuid" dev:db-id="sup">
                    <LN0 lnClass="LLN0" inst="" lnType="LLN0_T" uuid="sup-lln0-uuid" dev:db-id="sup-lln0"/>
                </LDevice>
            </Server>
        </AccessPoint>
    </IED>
    <DataTypeTemplates dev:db-id="types">
        <LNodeType id="LLN0_T" lnClass="LLN0" dev:db-id="lln0-type">
            <DO name="Beh" type="ENS_T" dev:db-id="lln0-beh"/>
        </LNodeType>
        <DOType id="ENS_T" cdc="ENS" dev:db-id="ens-type">
            <DA name="stVal" bType="INT32" fc="ST" dev:db-id="ens-stval"/>
        </DOType>
    </DataTypeTemplates>
</SCL>
