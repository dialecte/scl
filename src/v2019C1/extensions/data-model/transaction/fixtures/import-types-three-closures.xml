<?xml version="1.0" encoding="UTF-8"?>
<!-- Three LNodes, each with its own LNodeType -> DOType -> EnumType closure: nine types, three of each tag. -->
<SCL xmlns="http://www.iec.ch/61850/2003/SCL" xmlns:eIEC61850-6-100="http://www.iec.ch/61850/2019/SCL/6-100" xmlns:dev="http://dialecte.dev/XML/DEV" dev:db-id="scl-s">
    <Substation name="S1" dev:db-id="sub-s">
        <LNode iedName="None" lnClass="CSWI" lnInst="1" lnType="L1" dev:db-id="lnode-1"/>
        <LNode iedName="None" lnClass="CSWI" lnInst="2" lnType="L2" dev:db-id="lnode-2"/>
        <LNode iedName="None" lnClass="CSWI" lnInst="3" lnType="L3" dev:db-id="lnode-3"/>
    </Substation>
    <DataTypeTemplates dev:db-id="dtt-s">
        <LNodeType id="L1" lnClass="CSWI" dev:db-id="lnt-1"><DO name="Pos" type="D1" dev:db-id="do-1"/></LNodeType>
        <LNodeType id="L2" lnClass="CSWI" dev:db-id="lnt-2"><DO name="Pos" type="D2" dev:db-id="do-2"/></LNodeType>
        <LNodeType id="L3" lnClass="CSWI" dev:db-id="lnt-3"><DO name="Pos" type="D3" dev:db-id="do-3"/></LNodeType>
        <DOType id="D1" cdc="ENS" dev:db-id="dot-1"><DA name="stVal" bType="Enum" type="E1" fc="ST" dev:db-id="da-1"/></DOType>
        <DOType id="D2" cdc="ENS" dev:db-id="dot-2"><DA name="stVal" bType="Enum" type="E2" fc="ST" dev:db-id="da-2"/></DOType>
        <DOType id="D3" cdc="ENS" dev:db-id="dot-3"><DA name="stVal" bType="Enum" type="E3" fc="ST" dev:db-id="da-3"/></DOType>
        <EnumType id="E1" dev:db-id="et-1"><EnumVal ord="1" dev:db-id="ev-1">one</EnumVal></EnumType>
        <EnumType id="E2" dev:db-id="et-2"><EnumVal ord="2" dev:db-id="ev-2">two</EnumVal></EnumType>
        <EnumType id="E3" dev:db-id="et-3"><EnumVal ord="3" dev:db-id="ev-3">three</EnumVal></EnumType>
