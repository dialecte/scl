<?xml version="1.0" encoding="UTF-8"?>
<!-- IED7's GOOSE sends DS, whose entry names by uuid XCBR1 in the device LD2 served by IED7's second access point AP2;
     the same GOOSE is subscribed to by AP2 (IEDName by apUuid) -->
<SCL xmlns="http://www.iec.ch/61850/2003/SCL" xmlns:dev="http://dialecte.dev/XML/DEV" release="5" revision="C" version="2007" dev:db-id="project">
    <IED name="IED7" uuid="ied7" dev:db-id="ied7">
        <AccessPoint name="AP1" uuid="ap7" dev:db-id="ap7">
            <Server dev:db-id="srv7">
                <Authentication dev:db-id="auth7"/>
                <LDevice inst="LD1" uuid="ld7" dev:db-id="ld7">
                    <LN0 lnClass="LLN0" inst="" lnType="LLN0_T" uuid="ln07" dev:db-id="ln07">
                        <DataSet name="DS" dev:db-id="ds7">
                            <FCDA ldInst="LD2" lnClass="XCBR" lnInst="1" doName="Pos" daName="stVal" fc="ST" lnUuid="xcbr7" dev:db-id="fst7"/>
                        </DataSet>
                        <GSEControl name="GC" appID="GC" datSet="DS" confRev="1" uuid="gc7" dev:db-id="gc7">
                            <IEDName apRef="AP2" apUuid="ap7b" dev:db-id="sub7">IED7</IEDName>
                        </GSEControl>
                    </LN0>
                </LDevice>
            </Server>
        </AccessPoint>
        <AccessPoint name="AP2" uuid="ap7b" dev:db-id="ap7b">
            <Server dev:db-id="srv7b">
                <Authentication dev:db-id="auth7b"/>
                <LDevice inst="LD2" uuid="ld7b" dev:db-id="ld7b">
                    <LN0 lnClass="LLN0" inst="" lnType="LLN0_T" uuid="ln07b" dev:db-id="ln07b"/>
                    <LN lnClass="XCBR" inst="1" lnType="XCBR_T" uuid="xcbr7" dev:db-id="xcbr7"/>
                </LDevice>
            </Server>
        </AccessPoint>
    </IED>
    <DataTypeTemplates dev:db-id="dtt">
        <LNodeType id="LLN0_T" lnClass="LLN0" dev:db-id="lnt0"/>
        <LNodeType id="XCBR_T" lnClass="XCBR" dev:db-id="lnt1"><DO name="Pos" type="DPC_T" dev:db-id="do-pos"/></LNodeType>
        <DOType id="DPC_T" cdc="DPC" dev:db-id="dot">
            <DA name="stVal" fc="ST" bType="Dbpos" dev:db-id="da-st"/>
        </DOType>
    </DataTypeTemplates>
</SCL>
