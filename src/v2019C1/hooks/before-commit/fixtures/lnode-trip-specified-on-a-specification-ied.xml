                    <eIEC61850-6-100:LNodeInputs>
                        <eIEC61850-6-100:SourceRef input="Trip" extRefUuid="p1-trip-input-uuid" extRefAddr="LD0/Q0GGIO1.Trip"/>
                    </eIEC61850-6-100:LNodeInputs>
                </Private>
            </LNode>
        </Function>
    </Substation>
    <IED name="S_IED" dev:db-id="s-ied">
        <AccessPoint name="AP1">
            <Server>
                <Authentication/>
                <LDevice inst="LD0">
