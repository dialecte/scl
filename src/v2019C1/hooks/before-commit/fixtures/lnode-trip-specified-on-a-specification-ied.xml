                    <LN prefix="Q0" lnClass="XCBR" inst="2" lnType="XCBR_T" uuid="p1-breaker-uuid" dev:db-id="p1-breaker"/>
                    <LN lnClass="PTRC" inst="1" lnType="PTRC_T" uuid="p1-trip-uuid" dev:db-id="p1-trip"/>
