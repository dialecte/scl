                </Private>
            </LNode>
            <!-- specified on no IED, bound to P1's PTRC1 by its names only; its Trip input is P1's Q0GGIO1 ExtRef -->
            <LNode iedName="P1" ldInst="LD0" lnClass="PTRC" lnInst="1" uuid="trip-uuid" dev:db-id="trip">
