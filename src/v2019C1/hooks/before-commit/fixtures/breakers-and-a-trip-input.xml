<?xml version="1.0" encoding="UTF-8"?>
<!-- Function S1/F1 holds the process resources PR1 and PR2, the breakers XCBR1 and XCBR2 (type XCBR_T: Pos.stVal,
     Pos.q, Loc.stVal), two breakers both named XCBR3, a breaker XCBR4 of no type, a breaker bound to XCBR1 of IED1 named XCBR6 by
     its specification naming, and a trip PTRC1 whose input (SourceRef ref1) names Pos.stVal of
     XCBR1 by path and uuid, from resource PR1 -->
