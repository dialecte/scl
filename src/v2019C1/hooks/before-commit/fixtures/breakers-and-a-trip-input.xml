                <Private type="eIEC61850-6-100" dev:db-id="xcbr6-private">
                    <eIEC61850-6-100:LNodeSpecNaming sLnClass="XCBR" sLnInst="6" dev:db-id="xcbr6-naming"/>
                </Private>
            </LNode>
            <LNode iedName="None" lnClass="PTRC" lnInst="1" uuid="ptrc1" dev:db-id="ptrc1">
                <Private type="eIEC61850-6-100" dev:db-id="ptrc1-private">
                    <eIEC61850-6-100:LNodeInputs dev:db-id="inputs">
                        <eIEC61850-6-100:SourceRef input="Pos" source="S1/F1/XCBR1.Pos.stVal" sourceLNodeUuid="xcbr1" sourceDoName="Pos" sourceDaName="stVal" resourceName="PR1" resourceUuid="pr1" dev:db-id="ref1"/>
