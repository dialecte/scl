                    <eIEC61850-6-100:LNodeSpecNaming sLnClass="XCBR" sLnInst="1" dev:db-id="xcbr1-naming"/>
                </Private>
            </LNode>
            <LNode iedName="None" lnClass="XCBR" lnInst="2" lnType="XCBR_T" uuid="xcbr2" dev:db-id="xcbr2">
