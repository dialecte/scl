                    <eIEC61850-6-100:LNodeSpecNaming sLnClass="XCBR" sLnInst="2" dev:db-id="xcbr2-naming"/>
                </Private>
            </LNode>
            <LNode iedName="None" lnClass="XCBR" lnInst="3" lnType="XCBR_T" uuid="xcbr3" dev:db-id="xcbr3"/>
            <LNode iedName="None" lnClass="XCBR" lnInst="3" lnType="XCBR_T" uuid="xcbr3-again" dev:db-id="xcbr3-again"/>
