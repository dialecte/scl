<?xml version="1.0" encoding="UTF-8"?>
<!-- Bay S1/VL1/B1 holds the function F1 (uuid f1), the category C1 (uuid c1) and the variable V1 (uuid v1), each
     naming F1 and holding nothing else; the application A1 names C1 and V1 from its function role content, outside
     both of them -->
<SCL xmlns="http://www.iec.ch/61850/2003/SCL" xmlns:dev="http://dialecte.dev/XML/DEV" xmlns:eIEC61850-6-100="http://www.iec.ch/61850/2019/SCL/6-100" release="5" revision="C" version="2007" dev:db-id="project" eIEC61850-6-100:release="1" eIEC61850-6-100:revision="C" eIEC61850-6-100:version="2019">
    <Substation name="S1" dev:db-id="s1">
        <VoltageLevel name="VL1" dev:db-id="vl1">
            <Bay name="B1" dev:db-id="b1">
                <Private type="eIEC61850-6-100" dev:db-id="b1-private">
                    <eIEC61850-6-100:FunctionCategory name="C1" uuid="c1" dev:db-id="c1">
                        <eIEC61850-6-100:FunctionCatRef function="S1/VL1/B1/F1" functionUuid="f1" dev:db-id="cat-ref"/>
                    </eIEC61850-6-100:FunctionCategory>
                    <eIEC61850-6-100:Variable name="V1" value="1" uuid="v1" dev:db-id="v1">
                        <eIEC61850-6-100:VariableApplyTo element="S1/VL1/B1/F1" elementUuid="f1" dev:db-id="var-apply"/>
                    </eIEC61850-6-100:Variable>
                    <eIEC61850-6-100:Application name="Control" type="DCS" uuid="a1" dev:db-id="a1">
                        <eIEC61850-6-100:FunctionRole name="ROOT" uuid="r1" dev:db-id="r1">
                            <eIEC61850-6-100:FunctionRoleContent dev:db-id="content">
                                <eIEC61850-6-100:FunctionCategoryRef functionCategory="S1/VL1/B1/C1" functionCategoryUuid="c1" dev:db-id="cat-named"/>
                                <eIEC61850-6-100:VariableRef variable="S1/VL1/B1/V1" variableUuid="v1" dev:db-id="var-named"/>
                            </eIEC61850-6-100:FunctionRoleContent>
                        </eIEC61850-6-100:FunctionRole>
                    </eIEC61850-6-100:Application>
                </Private>
                <Function name="F1" uuid="f1" dev:db-id="f1"/>
            </Bay>
        </VoltageLevel>
    </Substation>
</SCL>
