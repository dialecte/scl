<?xml version="1.0" encoding="UTF-8"?>
<!-- F1: behaviour FB (naming XCBR1's data and CTL2), PTRC1, SF1 holding XCBR1; F2: CSWI1, out of FB's reach. IED A: AP1 on N1
     (CTRL sending PositionGoose; LD1: DS1, gcb1, PTRC1/Op; LD2; LD4: GGIO1/Beh), AP2 connected nowhere. IED B: AP1 on N1. -->
<SCL xmlns="http://www.iec.ch/61850/2003/SCL" xmlns:dev="http://dialecte.dev/XML/DEV" xmlns:eIEC61850-6-100="http://www.iec.ch/61850/2019/SCL/6-100" release="5" revision="C" version="2007" dev:db-id="project" eIEC61850-6-100:release="1" eIEC61850-6-100:revision="C" eIEC61850-6-100:version="2019">
    <Substation name="S1" dev:db-id="s1">
        <Function name="F1" uuid="f1" dev:db-id="f1">
            <Private type="eIEC61850-6-100" dev:db-id="f1-private">
                <eIEC61850-6-100:BehaviorDescription name="FB" dev:db-id="fb">
                    <eIEC61850-6-100:OutputVar varName="data" dataName="SF1/XCBR1.Pos.stVal" lnodeUuid="xcbr" doName="Pos" daName="stVal" dev:db-id="stored-data"/>
                    <eIEC61850-6-100:OutputVar varName="control" outputName="SF1/XCBR1.CTL2" outputUuid="ctl2" dev:db-id="stored-control"/>
                </eIEC61850-6-100:BehaviorDescription>
            </Private>
            <LNode iedName="None" lnClass="PTRC" lnInst="1" lnType="PTRC_T" uuid="ptrc" dev:db-id="ptrc">
                <Private type="eIEC61850-6-100" dev:db-id="ptrc-private">
                    <eIEC61850-6-100:LNodeInputs dev:db-id="ptrc-inputs">
                        <eIEC61850-6-100:SourceRef input="Trip" uuid="trip" dev:db-id="trip"/>
                    </eIEC61850-6-100:LNodeInputs>
                </Private>
            </LNode>
            <SubFunction name="SF1" uuid="sf1" dev:db-id="sf1">
                <LNode iedName="None" lnClass="XCBR" lnInst="1" lnType="XCBR_T" uuid="xcbr" dev:db-id="xcbr">
                    <Private type="eIEC61850-6-100" dev:db-id="xcbr-private">
                        <eIEC61850-6-100:LNodeOutputs dev:db-id="xcbr-outputs">
                            <eIEC61850-6-100:ControlRef output="CTL2" uuid="ctl2" dev:db-id="ctl2"/>
                        </eIEC61850-6-100:LNodeOutputs>
                    </Private>
                </LNode>
            </SubFunction>
        </Function>
        <Function name="F2" uuid="f2" dev:db-id="f2">
            <LNode iedName="None" lnClass="CSWI" lnInst="1" lnType="CSWI_T" uuid="cswi" dev:db-id="cswi"/>
        </Function>
    </Substation>
    <Communication dev:db-id="communication">
        <SubNetwork name="N1" dev:db-id="n1">
            <ConnectedAP iedName="A" apName="AP1" apUuid="a-ap1-uuid" dev:db-id="connected-ap-a">
                <GSE ldInst="CTRL" cbName="PositionGoose" cbUuid="position-goose-uuid" dev:db-id="position-gse"/>
                <GSE ldInst="LD1" cbName="gcb1" cbUuid="gcb1-uuid" dev:db-id="gse1"/>
            </ConnectedAP>
            <ConnectedAP iedName="B" apName="AP1" apUuid="b-ap1-uuid" dev:db-id="connected-ap-b"/>
        </SubNetwork>
    </Communication>
    <IED name="A" uuid="ied-a-uuid" dev:db-id="ied-a">
        <AccessPoint name="AP1" uuid="a-ap1-uuid" dev:db-id="a-ap1">
            <Server dev:db-id="a-server1">
                <Authentication dev:db-id="a-authentication1"/>
                <LDevice inst="CTRL" uuid="ctrl-uuid" dev:db-id="ctrl">
                    <LN0 lnClass="LLN0" inst="" lnType="LLN0_T" uuid="ctrl-lln0-uuid" dev:db-id="ctrl-lln0">
                        <GSEControl name="PositionGoose" appID="POS" confRev="1" uuid="position-goose-uuid" dev:db-id="position-goose"/>
                    </LN0>
                </LDevice>
                <LDevice inst="LD1" uuid="ld1-uuid" dev:db-id="ld1">
                    <LN0 lnClass="LLN0" inst="" lnType="LLN0_T" uuid="ld1-lln0-uuid" dev:db-id="ld1-lln0">
                        <DataSet name="DS1" dev:db-id="ds1">
                            <FCDA ldInst="LD1" prefix="" lnClass="PTRC" lnInst="1" doName="Op" daName="general" fc="ST" dev:db-id="fcda1"/>
                        </DataSet>
                        <GSEControl name="gcb1" appID="G1" datSet="DS1" confRev="1" uuid="gcb1-uuid" dev:db-id="gcb1"/>
                    </LN0>
                    <LN lnClass="PTRC" inst="1" prefix="" lnType="PTRC_T" uuid="ld1-ptrc1-uuid" dev:db-id="ld1-ptrc1">
                        <DOI name="Op" dev:db-id="op"/>
                    </LN>
                </LDevice>
                <LDevice inst="LD2" uuid="ld2-uuid" dev:db-id="ld2">
                    <LN0 lnClass="LLN0" inst="" lnType="LLN0_T" uuid="ld2-lln0-uuid" dev:db-id="ld2-lln0"/>
                    <LN lnClass="XCBR" inst="1" prefix="" lnType="XCBR_T" uuid="ld2-xcbr1-uuid" dev:db-id="ld2-xcbr1"/>
                </LDevice>
                <LDevice inst="LD4" uuid="ld4-uuid" dev:db-id="ld4">
                    <LN0 lnClass="LLN0" inst="" lnType="LLN0_T" uuid="ld4-lln0-uuid" dev:db-id="ld4-lln0"/>
                    <LN lnClass="GGIO" inst="1" prefix="" lnType="GGIO_T" uuid="ld4-ggio1-uuid" dev:db-id="ld4-ggio1">
                        <DOI name="Beh" dev:db-id="ind"/>
                    </LN>
                </LDevice>
            </Server>
        </AccessPoint>
        <AccessPoint name="AP2" uuid="a-ap2-uuid" dev:db-id="a-ap2">
            <Server dev:db-id="a-server2">
                <Authentication dev:db-id="a-authentication2"/>
                <LDevice inst="SUP" uuid="sup-uuid" dev:db-id="sup">
                    <LN0 lnClass="LLN0" inst="" lnType="LLN0_T" uuid="sup-lln0-uuid" dev:db-id="sup-lln0"/>
                </LDevice>
            </Server>
        </AccessPoint>
    </IED>
    <IED name="B" uuid="ied-b-uuid" dev:db-id="ied-b">
        <AccessPoint name="AP1" uuid="b-ap1-uuid" dev:db-id="b-ap1">
            <Server dev:db-id="b-server">
                <Authentication dev:db-id="b-authentication"/>
                <LDevice inst="LDB" uuid="ldb-uuid" dev:db-id="ldb">
                    <LN0 lnClass="LLN0" inst="" lnType="LLN0_T" uuid="ldb-lln0-uuid" dev:db-id="ldb-lln0"/>
                </LDevice>
            </Server>
        </AccessPoint>
    </IED>
    <DataTypeTemplates dev:db-id="templates">
        <LNodeType id="LLN0_T" lnClass="LLN0" dev:db-id="lln0-type">
            <DO name="Beh" type="ENS_T" dev:db-id="lln0-beh"/>
        </LNodeType>
        <LNodeType id="GGIO_T" lnClass="GGIO" dev:db-id="ggio-type">
            <DO name="Beh" type="ENS_T" dev:db-id="ggio-beh"/>
        </LNodeType>
        <LNodeType id="PTRC_T" lnClass="PTRC" dev:db-id="ptrc-type">
            <DO name="Op" type="ACT_T" dev:db-id="ptrc-op"/>
        </LNodeType>
        <LNodeType id="XCBR_T" lnClass="XCBR" dev:db-id="xcbr-type">
            <DO name="Pos" type="DPC_T" dev:db-id="xcbr-pos"/>
        </LNodeType>
        <LNodeType id="CSWI_T" lnClass="CSWI" dev:db-id="cswi-type">
            <DO name="Pos" type="DPC_T" dev:db-id="cswi-pos"/>
        </LNodeType>
        <DOType id="ENS_T" cdc="ENS" dev:db-id="ens-type">
            <DA name="stVal" bType="INT32" fc="ST" dev:db-id="ens-stval"/>
        </DOType>
        <DOType id="ACT_T" cdc="ACT" dev:db-id="act-type">
            <DA name="general" bType="BOOLEAN" fc="ST" dev:db-id="act-general"/>
        </DOType>
        <DOType id="DPC_T" cdc="DPC" dev:db-id="dpc-type">
            <DA name="stVal" bType="Dbpos" fc="ST" dev:db-id="dpc-stval"/>
        </DOType>
    </DataTypeTemplates>
</SCL>
