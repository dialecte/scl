<?xml version="1.0" encoding="UTF-8"?>
<!-- IED1's LLN0 holds the data sets DS1 and DS2 of one entry each, sent by GC1 and GC2 -->
<SCL xmlns="http://www.iec.ch/61850/2003/SCL" xmlns:dev="http://dialecte.dev/XML/DEV" xmlns:eIEC61850-6-100="http://www.iec.ch/61850/2019/SCL/6-100" release="5" revision="C" version="2007" dev:db-id="project" eIEC61850-6-100:release="1" eIEC61850-6-100:revision="C" eIEC61850-6-100:version="2019">
    <Header id="project" dev:db-id="header"/>
    <IED name="IED1" dev:db-id="ied1">
        <AccessPoint name="AP1" dev:db-id="ied1-ap">
            <Server dev:db-id="ied1-server">
                <Authentication dev:db-id="ied1-authentication"/>
                <LDevice inst="LD1" dev:db-id="ied1-ld">
                    <LN0 lnClass="LLN0" inst="" lnType="LLN0_T" dev:db-id="ied1-lln0">
                        <DataSet name="DS1" dev:db-id="ds1">
                            <FCDA ldInst="LD1" lnClass="LLN0" doName="Beh" daName="stVal" fc="ST" dev:db-id="ds1-entry"/>
                        </DataSet>
                        <DataSet name="DS2" dev:db-id="ds2">
                            <FCDA ldInst="LD1" lnClass="LLN0" doName="Beh" daName="stVal" fc="ST" dev:db-id="ds2-entry"/>
                        </DataSet>
                        <GSEControl name="GC1" appID="GC1" datSet="DS1" confRev="1" dev:db-id="gc1"/>
                        <GSEControl name="GC2" appID="GC2" datSet="DS2" confRev="1" dev:db-id="gc2"/>
                    </LN0>
                </LDevice>
            </Server>
        </AccessPoint>
    </IED>
    <DataTypeTemplates dev:db-id="templates">
        <LNodeType id="LLN0_T" lnClass="LLN0" dev:db-id="lln0-type">
            <DO name="Beh" type="ENS_T" dev:db-id="beh"/>
        </LNodeType>
        <DOType id="ENS_T" cdc="ENS" dev:db-id="ens-type">
            <DA name="stVal" bType="Enum" type="Beh_E" fc="ST" dev:db-id="st-val"/>
        </DOType>
        <EnumType id="Beh_E" dev:db-id="beh-enum">
            <EnumVal ord="1" dev:db-id="on">on</EnumVal>
        </EnumType>
    </DataTypeTemplates>
</SCL>
