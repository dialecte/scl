<?xml version="1.0" encoding="UTF-8"?>
<!-- S1/VL1/B1/F1 holds the process resource PR1 (uuid pr1), the sub functions SF1 and SF2, and the behaviour BD1 whose
     input in1 names the data Op.general of PTRC1 locally from F1; PTRC1 (in SF1) takes its input Trip (source-ref,
     uuid sr1) and subscribes (subscriber) from PR1, and its own behaviour BD2 reads that input (in2); F2 holds nothing -->
<SCL xmlns="http://www.iec.ch/61850/2003/SCL" xmlns:dev="http://dialecte.dev/XML/DEV" xmlns:eIEC61850-6-100="http://www.iec.ch/61850/2019/SCL/6-100" release="5" revision="C" version="2007" dev:db-id="project" eIEC61850-6-100:release="1" eIEC61850-6-100:revision="C" eIEC61850-6-100:version="2019">
    <Substation name="S1" dev:db-id="s1">
        <VoltageLevel name="VL1" dev:db-id="vl1">
            <Bay name="B1" dev:db-id="b1">
                <Function name="F1" uuid="f1" dev:db-id="f1">
                    <Private type="eIEC61850-6-100" dev:db-id="f1-private">
                        <eIEC61850-6-100:ProcessResources dev:db-id="resources">
                            <eIEC61850-6-100:ProcessResource name="PR1" uuid="pr1" dev:db-id="pr1"/>
                        </eIEC61850-6-100:ProcessResources>
                        <eIEC61850-6-100:BehaviorDescription name="BD1" uuid="bd1" dev:db-id="bd1">
                            <eIEC61850-6-100:InputVar varName="in1" dataName="SF1/PTRC1.Op.general" lnodeUuid="ln-ptrc" doName="Op" daName="general" dev:db-id="in1"/>
                        </eIEC61850-6-100:BehaviorDescription>
                    </Private>
                    <SubFunction name="SF1" uuid="sf1" dev:db-id="sf1">
                        <LNode iedName="None" lnClass="PTRC" lnInst="1" uuid="ln-ptrc" dev:db-id="ptrc1">
                            <Private type="eIEC61850-6-100" dev:db-id="ptrc1-private">
                                <eIEC61850-6-100:LNodeInputs dev:db-id="ptrc1-inputs">
                                    <eIEC61850-6-100:SourceRef input="Trip" resourceName="PR1" resourceUuid="pr1" uuid="sr1" dev:db-id="source-ref"/>
                                </eIEC61850-6-100:LNodeInputs>
                                <eIEC61850-6-100:DOS name="Op" dev:db-id="ptrc1-op">
                                    <eIEC61850-6-100:SubscriberLNode resourceName="PR1" resourceUuid="pr1" inputName="Trip" dev:db-id="subscriber"/>
                                </eIEC61850-6-100:DOS>
                                <eIEC61850-6-100:BehaviorDescription name="BD2" uuid="bd2" dev:db-id="bd2">
                                    <eIEC61850-6-100:InputVar varName="in2" inputName="Trip" inputUuid="sr1" dev:db-id="in2"/>
                                </eIEC61850-6-100:BehaviorDescription>
                            </Private>
                        </LNode>
                    </SubFunction>
                    <SubFunction name="SF2" uuid="sf2" dev:db-id="sf2"/>
                </Function>
                <Function name="F2" uuid="f2" dev:db-id="f2"/>
            </Bay>
        </VoltageLevel>
    </Substation>
</SCL>
