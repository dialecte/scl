<?xml version="1.0" encoding="UTF-8"?>
<!-- S1/VL1/B1 holds the node L1 (uuid n1), the breaker QA1 whose terminal t-inner names L1, the function F1 (uuid f1)
     with the sub function SF1 (uuid sf1, holding the LNode XCBR1, uuid ln3) and the LNode PTRC1 (uuid ln1), and the category C1 naming F1 (ref1);
     S1/VL1/B2 holds QA2 whose terminal t-outer names L1, and F2 whose LNode CSWI1 takes its inputs from PTRC1 (source-ref) and XCBR1 (source-ref-2);
     S1/VL2/B3 holds nothing; no element names a path to S1/VL1/B2/F1 -->
<SCL xmlns="http://www.iec.ch/61850/2003/SCL" xmlns:dev="http://dialecte.dev/XML/DEV" xmlns:eIEC61850-6-100="http://www.iec.ch/61850/2019/SCL/6-100" release="5" revision="C" version="2007" dev:db-id="project" eIEC61850-6-100:release="1" eIEC61850-6-100:revision="C" eIEC61850-6-100:version="2019">
    <Substation name="S1" dev:db-id="s1">
        <VoltageLevel name="VL1" dev:db-id="vl1">
            <Bay name="B1" dev:db-id="b1">
                <Private type="eIEC61850-6-100" dev:db-id="b1-private">
                    <eIEC61850-6-100:FunctionCategory name="C1" uuid="c1" dev:db-id="c1">
                        <eIEC61850-6-100:FunctionCatRef function="S1/VL1/B1/F1" functionUuid="f1" dev:db-id="ref1"/>
                    </eIEC61850-6-100:FunctionCategory>
                </Private>
                <ConductingEquipment name="QA1" type="CBR" dev:db-id="qa1">
                    <Terminal connectivityNode="S1/VL1/B1/L1" substationName="S1" voltageLevelName="VL1" bayName="B1" cNodeName="L1" cNodeUuid="n1" dev:db-id="t-inner"/>
                </ConductingEquipment>
                <ConnectivityNode name="L1" pathName="S1/VL1/B1/L1" uuid="n1" dev:db-id="l1"/>
                <Function name="F1" uuid="f1" dev:db-id="f1">
                    <SubFunction name="SF1" uuid="sf1" dev:db-id="sf1">
                        <LNode iedName="None" lnClass="XCBR" lnInst="1" uuid="ln3" dev:db-id="ln3"/>
                    </SubFunction>
                    <LNode iedName="None" lnClass="PTRC" lnInst="1" uuid="ln1" dev:db-id="ln1"/>
                </Function>
            </Bay>
            <Bay name="B2" dev:db-id="b2">
                <ConductingEquipment name="QA2" type="CBR" dev:db-id="qa2">
                    <Terminal connectivityNode="S1/VL1/B1/L1" substationName="S1" voltageLevelName="VL1" bayName="B1" cNodeName="L1" cNodeUuid="n1" dev:db-id="t-outer"/>
                </ConductingEquipment>
                <Function name="F2" uuid="f2" dev:db-id="f2">
                    <LNode iedName="None" lnClass="CSWI" lnInst="1" uuid="ln2" dev:db-id="ln2">
                        <Private type="eIEC61850-6-100" dev:db-id="ln2-private">
                            <eIEC61850-6-100:LNodeInputs dev:db-id="ln2-inputs">
                                <eIEC61850-6-100:SourceRef input="Trip" source="S1/VL1/B1/F1/PTRC1.Op" sourceLNodeUuid="ln1" sourceDoName="Op" dev:db-id="source-ref"/>
                                <eIEC61850-6-100:SourceRef input="Pos" source="S1/VL1/B1/F1/SF1/XCBR1.Pos" sourceLNodeUuid="ln3" sourceDoName="Pos" dev:db-id="source-ref-2"/>
                            </eIEC61850-6-100:LNodeInputs>
                        </Private>
                    </LNode>
                </Function>
            </Bay>
        </VoltageLevel>
        <VoltageLevel name="VL2" dev:db-id="vl2">
            <Bay name="B3" dev:db-id="b3"/>
        </VoltageLevel>
    </Substation>
</SCL>
