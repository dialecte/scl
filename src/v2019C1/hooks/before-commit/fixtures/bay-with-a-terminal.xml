<?xml version="1.0" encoding="UTF-8"?>
<!-- Bay S1/VL1/B1 holds the connectivity nodes L1 (uuid n1) and L2 (uuid n2); its breaker QA1's terminal is connected to
     L1 by path, level names and uuid; its earthing switch QE1's terminal names the grounded node, which no file holds -->
<SCL xmlns="http://www.iec.ch/61850/2003/SCL" xmlns:dev="http://dialecte.dev/XML/DEV" release="5" revision="C" version="2007" dev:db-id="project">
    <Substation name="S1" dev:db-id="s1">
        <VoltageLevel name="VL1" dev:db-id="vl1">
            <Bay name="B1" dev:db-id="b1">
                <ConductingEquipment name="QA1" type="CBR" dev:db-id="qa1">
                    <Terminal connectivityNode="S1/VL1/B1/L1" substationName="S1" voltageLevelName="VL1" bayName="B1" cNodeName="L1" cNodeUuid="n1" dev:db-id="t1"/>
                </ConductingEquipment>
                <ConductingEquipment name="QE1" type="DIS" dev:db-id="qe1">
                    <Terminal connectivityNode="S1/VL1/B1/grounded" substationName="S1" voltageLevelName="VL1" bayName="B1" cNodeName="grounded" dev:db-id="t2"/>
                </ConductingEquipment>
                <ConnectivityNode name="L1" pathName="S1/VL1/B1/L1" uuid="n1" dev:db-id="l1"/>
                <ConnectivityNode name="L2" pathName="S1/VL1/B1/L2" uuid="n2" dev:db-id="l2"/>
            </Bay>
        </VoltageLevel>
    </Substation>
</SCL>
