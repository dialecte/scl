<?xml version="1.0" encoding="UTF-8"?>
<!-- The subnetwork connects IED7's AP1 (ConnectedAP by apUuid) with the address of its GOOSE C1 (GSE by cbUuid). IED7
     holds XCBR1 and, in a vendor Private, a copy of a logical node XCBR4 (uuid xcbr4-copy). IED8 (access point AP1)
     holds its own GOOSE C1, CSWI1 and an input naming IED7's XCBR1 and GOOSE by uuid, its control block in the data's
     device (no srcLDInst) and its service GOOSE. -->
<SCL xmlns="http://www.iec.ch/61850/2003/SCL" xmlns:dev="http://dialecte.dev/XML/DEV" release="5" revision="C" version="2007" dev:db-id="project">
    <Communication dev:db-id="com">
        <SubNetwork name="N1" dev:db-id="n1">
            <ConnectedAP iedName="IED7" apName="AP1" apUuid="ap7" dev:db-id="cap7">
                <GSE ldInst="LD1" cbName="C1" cbUuid="gc7" dev:db-id="gse7"/>
            </ConnectedAP>
        </SubNetwork>
    </Communication>
    <IED name="IED7" uuid="ied7" dev:db-id="ied7">
        <Private type="vendor-copy" dev:db-id="vendor7">
            <LN lnClass="XCBR" inst="4" lnType="XCBR_T" uuid="xcbr4-copy" dev:db-id="xcbr4-copy"/>
        </Private>
        <AccessPoint name="AP1" uuid="ap7" dev:db-id="ap7">
            <Server dev:db-id="srv7">
                <Authentication dev:db-id="auth7"/>
                <LDevice inst="LD1" uuid="ld7" dev:db-id="ld7">
                    <LN0 lnClass="LLN0" inst="" lnType="LLN0_T" uuid="ln07" dev:db-id="ln07">
                        <DataSet name="DS" dev:db-id="ds7"/>
                        <GSEControl name="C1" appID="C1" confRev="1" uuid="gc7" dev:db-id="gc7"/>
                    </LN0>
                    <LN lnClass="XCBR" inst="1" lnType="XCBR_T" uuid="xcbr7" dev:db-id="xcbr7"/>
                </LDevice>
            </Server>
        </AccessPoint>
    </IED>
    <IED name="IED8" uuid="ied8" dev:db-id="ied8">
        <AccessPoint name="AP1" uuid="ap8" dev:db-id="ap8">
            <Server dev:db-id="srv8">
                <Authentication dev:db-id="auth8"/>
                <LDevice inst="LD1" uuid="ld8" dev:db-id="ld8">
                    <LN0 lnClass="LLN0" inst="" lnType="LLN0_T" uuid="ln08" dev:db-id="ln08">
                        <Inputs dev:db-id="in8">
                            <ExtRef iedName="IED7" ldInst="LD1" lnClass="XCBR" lnInst="1" doName="Pos" lnUuid="xcbr7" serviceType="GOOSE" srcLNClass="LLN0" srcCBName="C1" srcCBUuid="gc7" intAddr="pos" dev:db-id="ext8"/>
                        </Inputs>
                        <GSEControl name="C1" appID="C1b" confRev="1" uuid="gc8" dev:db-id="gc8"/>
                    </LN0>
                    <LN lnClass="CSWI" inst="1" lnType="CSWI_T" uuid="cswi8" dev:db-id="cswi8"/>
                </LDevice>
            </Server>
        </AccessPoint>
    </IED>
    <DataTypeTemplates dev:db-id="dtt">
        <LNodeType id="LLN0_T" lnClass="LLN0" dev:db-id="lnt0"/>
        <LNodeType id="XCBR_T" lnClass="XCBR" dev:db-id="lnt1"><DO name="Pos" type="DPC_T" dev:db-id="do-pos"/></LNodeType>
        <LNodeType id="CSWI_T" lnClass="CSWI" dev:db-id="lnt2"/>
        <DOType id="DPC_T" cdc="DPC" dev:db-id="dot">
            <DA name="stVal" fc="ST" bType="Dbpos" dev:db-id="da-st"/>
        </DOType>
    </DataTypeTemplates>
</SCL>
