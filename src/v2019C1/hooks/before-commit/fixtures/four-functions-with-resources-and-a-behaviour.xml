<?xml version="1.0" encoding="UTF-8"?>
<!-- S1/VL1/B1 holds F1, whose Private holds only its resources with PR1; F2, whose Private holds its resources with PR2;
     F3, holding nothing; F4, whose Private holds only the behaviours BD4 and BD5 -->
<SCL xmlns="http://www.iec.ch/61850/2003/SCL" xmlns:dev="http://dialecte.dev/XML/DEV" xmlns:eIEC61850-6-100="http://www.iec.ch/61850/2019/SCL/6-100" release="5" revision="C" version="2007" dev:db-id="project" eIEC61850-6-100:release="1" eIEC61850-6-100:revision="C" eIEC61850-6-100:version="2019">
    <Substation name="S1" dev:db-id="s1">
        <VoltageLevel name="VL1" dev:db-id="vl1">
            <Bay name="B1" dev:db-id="b1">
                <Function name="F1" uuid="f1" dev:db-id="f1">
                    <Private type="eIEC61850-6-100" dev:db-id="f1-private">
                        <eIEC61850-6-100:ProcessResources dev:db-id="f1-resources">
                            <eIEC61850-6-100:ProcessResource name="PR1" uuid="pr1" dev:db-id="pr1"/>
                        </eIEC61850-6-100:ProcessResources>
                    </Private>
                </Function>
                <Function name="F2" uuid="f2" dev:db-id="f2">
                    <Private type="eIEC61850-6-100" dev:db-id="f2-private">
                        <eIEC61850-6-100:ProcessResources dev:db-id="f2-resources">
                            <eIEC61850-6-100:ProcessResource name="PR2" uuid="pr2" dev:db-id="pr2"/>
                        </eIEC61850-6-100:ProcessResources>
                    </Private>
                </Function>
                <Function name="F3" uuid="f3" dev:db-id="f3"/>
                <Function name="F4" uuid="f4" dev:db-id="f4">
                    <Private type="eIEC61850-6-100" dev:db-id="f4-private">
                        <eIEC61850-6-100:BehaviorDescription name="BD4" uuid="bd4" dev:db-id="bd4"/>
                        <eIEC61850-6-100:BehaviorDescription name="BD5" uuid="bd5" dev:db-id="bd5"/>
                    </Private>
                </Function>
            </Bay>
        </VoltageLevel>
    </Substation>
</SCL>
