<?xml version="1.0" encoding="UTF-8"?>
<!-- Voltage level S1/VL1 holds two bays with the same referrers: B1 (8 elements below it) and B2 (21 elements below it).
     In each, the category C1 names F1 by path and uuid, and QA1's terminal is connected to L1 by path, level names and
     uuid; F1 of B1 holds an LNode. B2 also holds the nodes L2 and L3 and the functions F2-F4, each with a sub function
     holding an LNode and an LNode of its own; no reference names them. -->
<SCL xmlns="http://www.iec.ch/61850/2003/SCL" xmlns:dev="http://dialecte.dev/XML/DEV" xmlns:eIEC61850-6-100="http://www.iec.ch/61850/2019/SCL/6-100" release="5" revision="C" version="2007" dev:db-id="project" eIEC61850-6-100:release="1" eIEC61850-6-100:revision="C" eIEC61850-6-100:version="2019">
    <Substation name="S1" dev:db-id="s1">
        <VoltageLevel name="VL1" dev:db-id="vl1">
            <Bay name="B1" uuid="b1" dev:db-id="b1">
                <Private type="eIEC61850-6-100" dev:db-id="b1-private">
                    <eIEC61850-6-100:FunctionCategory name="C1" uuid="b1-c1" dev:db-id="b1-c1">
                        <eIEC61850-6-100:FunctionCatRef function="S1/VL1/B1/F1" functionUuid="b1-f1" dev:db-id="b1-ref1"/>
                    </eIEC61850-6-100:FunctionCategory>
                </Private>
                <ConductingEquipment name="QA1" type="CBR" dev:db-id="b1-qa1">
                    <Terminal connectivityNode="S1/VL1/B1/L1" substationName="S1" voltageLevelName="VL1" bayName="B1" cNodeName="L1" cNodeUuid="b1-l1" dev:db-id="b1-t1"/>
                </ConductingEquipment>
                <ConnectivityNode name="L1" pathName="S1/VL1/B1/L1" uuid="b1-l1" dev:db-id="b1-l1"/>
                <Function name="F1" uuid="b1-f1" dev:db-id="b1-f1">
                    <LNode lnClass="XCBR" lnInst="1" iedName="None" uuid="b1-f1-ln1" dev:db-id="b1-f1-ln1"/>
                </Function>
            </Bay>
            <Bay name="B2" uuid="b2" dev:db-id="b2">
                <Private type="eIEC61850-6-100" dev:db-id="b2-private">
                    <eIEC61850-6-100:FunctionCategory name="C1" uuid="b2-c1" dev:db-id="b2-c1">
                        <eIEC61850-6-100:FunctionCatRef function="S1/VL1/B2/F1" functionUuid="b2-f1" dev:db-id="b2-ref1"/>
                    </eIEC61850-6-100:FunctionCategory>
                </Private>
                <ConductingEquipment name="QA1" type="CBR" dev:db-id="b2-qa1">
                    <Terminal connectivityNode="S1/VL1/B2/L1" substationName="S1" voltageLevelName="VL1" bayName="B2" cNodeName="L1" cNodeUuid="b2-l1" dev:db-id="b2-t1"/>
                </ConductingEquipment>
                <ConnectivityNode name="L1" pathName="S1/VL1/B2/L1" uuid="b2-l1" dev:db-id="b2-l1"/>
                <ConnectivityNode name="L2" pathName="S1/VL1/B2/L2" uuid="b2-l2" dev:db-id="b2-l2"/>
                <ConnectivityNode name="L3" pathName="S1/VL1/B2/L3" uuid="b2-l3" dev:db-id="b2-l3"/>
                <Function name="F1" uuid="b2-f1" dev:db-id="b2-f1"/>
                <Function name="F2" uuid="b2-f2" dev:db-id="b2-f2">
                    <SubFunction name="SF1" uuid="b2-f2-sf1" dev:db-id="b2-f2-sf1">
                        <LNode lnClass="XCBR" lnInst="1" iedName="None" uuid="b2-f2-ln1" dev:db-id="b2-f2-ln1"/>
                    </SubFunction>
                    <LNode lnClass="CSWI" lnInst="1" iedName="None" uuid="b2-f2-ln2" dev:db-id="b2-f2-ln2"/>
                </Function>
                <Function name="F3" uuid="b2-f3" dev:db-id="b2-f3">
                    <SubFunction name="SF1" uuid="b2-f3-sf1" dev:db-id="b2-f3-sf1">
                        <LNode lnClass="XCBR" lnInst="1" iedName="None" uuid="b2-f3-ln1" dev:db-id="b2-f3-ln1"/>
                    </SubFunction>
                    <LNode lnClass="CSWI" lnInst="1" iedName="None" uuid="b2-f3-ln2" dev:db-id="b2-f3-ln2"/>
                </Function>
                <Function name="F4" uuid="b2-f4" dev:db-id="b2-f4">
                    <SubFunction name="SF1" uuid="b2-f4-sf1" dev:db-id="b2-f4-sf1">
                        <LNode lnClass="XCBR" lnInst="1" iedName="None" uuid="b2-f4-ln1" dev:db-id="b2-f4-ln1"/>
                    </SubFunction>
                    <LNode lnClass="CSWI" lnInst="1" iedName="None" uuid="b2-f4-ln2" dev:db-id="b2-f4-ln2"/>
                </Function>
            </Bay>
        </VoltageLevel>
    </Substation>
</SCL>
